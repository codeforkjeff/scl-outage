<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seattle City Light Outages</title>
  <style>
    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --details-bg: #f8fafc;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --accent-color: #0284c7;
      --accent-hover: #0369a1;
      --badge-bg: #fef2f2;
      --badge-color: #b91c1c;
      --badge-border: #fecaca;
      --tag-bg: #f1f5f9;
      --tag-color: #475569;
      --btn-bg: #ffffff;
      --btn-color: #1e293b;
      --btn-border: #cbd5e1;
      --btn-hover: #f1f5f9;
      --radius: 8px;
      --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-color: #0f172a;
        --card-bg: #1e293b;
        --details-bg: #0f172a;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border-color: #334155;
        --accent-color: #38bdf8;
        --accent-hover: #7dd3fc;
        --badge-bg: #450a0a;
        --badge-color: #fca5a5;
        --badge-border: #7f1d1d;
        --tag-bg: #334155;
        --tag-color: #cbd5e1;
        --btn-bg: #1e293b;
        --btn-color: #f8fafc;
        --btn-border: #475569;
        --btn-hover: #334155;
        --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.4);
      }
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      line-height: 1.5;
      margin: 0;
      padding: 2rem 1rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .page-header {
      margin-bottom: 1.5rem;
    }

    h1 {
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      margin: 0 0 0.5rem 0;
      color: var(--text-main);
    }

    .subtitle {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin: 0;
    }

    .subtitle a {
      color: var(--accent-color);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .no-events {
      text-align: center;
      padding: 3rem 1rem;
    }

    .events-list {
      margin-top: 1rem;
    }

    .table-container {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .events-table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }

    .events-table th,
    .events-table td {
      padding: 0.75rem 0.85rem;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    .events-table th {
      background-color: var(--details-bg);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 1;
    }

    .events-table tbody tr.event-row {
      transition: background-color 0.15s ease;
    }

    .events-table tbody tr.event-row:hover {
      background-color: var(--details-bg);
    }

    .events-table tbody tr.event-row.is-expanded {
      background-color: var(--details-bg);
    }

    .col-neighborhood {
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
    }

    .col-title {
      font-weight: 500;
      color: var(--text-main);
    }

    .col-affected {
      text-align: right;
      white-space: nowrap;
    }

    th.col-affected {
      text-align: right;
    }

    .col-status {
      white-space: nowrap;
    }

    .col-cause {
      color: var(--text-main);
    }

    .col-start,
    .col-etr,
    .col-updated {
      white-space: nowrap;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .col-map,
    th.col-map {
      text-align: center;
      white-space: nowrap;
    }

    .badge-impact {
      display: inline-block;
      font-weight: 600;
      font-size: 0.85rem;
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
      background-color: var(--badge-bg);
      color: var(--badge-color);
      border: 1px solid var(--badge-border);
      white-space: nowrap;
    }

    .status-tag {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      background-color: var(--tag-bg);
      color: var(--tag-color);
      font-size: 0.8rem;
      font-weight: 500;
    }

    .map-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.35rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent-color);
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
      border-radius: 4px;
      transition: color 0.15s ease, background-color 0.15s ease;
    }

    .map-link:hover {
      color: var(--accent-hover);
      background-color: var(--btn-hover);
    }

    .map-link:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
    }

    .hidden {
      display: none !important;
    }

    .events-table tr.map-row {
      background-color: var(--details-bg);
    }

    .events-table tr.map-row td {
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
    }

    .map-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: sticky;
      left: 0;
      width: 100%;
      max-width: calc(100vw - 2.5rem);
      margin: 0 auto;
      min-height: 120px;
    }

    .map-loader {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 1.5rem 1rem;
      color: var(--text-muted);
      font-size: 0.9rem;
      background-color: var(--card-bg);
      border-radius: 6px;
      border: 1px solid var(--border-color);
    }

    .map-spinner {
      width: 1.25rem;
      height: 1.25rem;
      border: 2px solid var(--border-color);
      border-top-color: var(--accent-color);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .map-container img {
      display: block;
      max-width: 100%;
      max-height: 520px;
      width: auto;
      height: auto;
      border-radius: 6px;
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow);
    }

    .map-container img.is-loading {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .page-footer {
      margin-top: 2.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-color);
      text-align: center;
    }

    .github-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .github-link:hover {
      color: var(--text-main);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .github-link:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .github-link svg {
      width: 1rem;
      height: 1rem;
      fill: currentColor;
    }

    .emoji {
      font-family: Apple Color Emoji,Segoe UI Emoji, Noto Color Emoji ,Android Emoji,EmojiSymbols,EmojiOne Mozilla,Twemoji Mozilla,Segoe UI Symbol,Noto Color Emoji Compat,emoji;
      font-size: 10vmin;
    }

    @media (max-width: 768px) {
      body {
        padding: 1rem 0.5rem;
      }

      .page-header h1 {
        font-size: 1.4rem;
      }

      .table-container {
        overflow-x: visible;
        background: transparent;
        border: none;
        box-shadow: none;
      }

      .events-table {
        display: block;
        width: 100%;
        min-width: 0;
        border: none;
      }

      .events-table thead {
        display: none;
      }

      .events-table tbody {
        display: block;
        width: 100%;
      }

      .events-table tr.event-row {
        display: block;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 1rem;
        overflow: hidden;
      }

      .events-table tbody tr.event-row:hover {
        background-color: var(--card-bg);
      }

      .events-table tbody tr.event-row.is-expanded {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom: none;
        margin-bottom: 0;
        background-color: var(--card-bg);
      }

      .events-table tr.event-row td {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.85rem;
        border-bottom: 1px solid var(--border-color);
        text-align: right;
        font-size: 0.85rem;
        white-space: normal;
      }

      .events-table tr.event-row td:last-child {
        border-bottom: none;
      }

      .events-table tr.event-row td::before {
        content: attr(data-label);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        text-align: left;
        flex-shrink: 0;
      }

      .events-table td.col-neighborhood {
        font-weight: 600;
      }

      .events-table td.col-affected,
      .events-table td.col-status,
      .events-table td.col-start,
      .events-table td.col-etr,
      .events-table td.col-updated,
      .events-table td.col-map {
        text-align: right;
      }

      .events-table tr.map-row {
        display: block;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-top: 1px dashed var(--border-color);
        border-bottom-left-radius: var(--radius);
        border-bottom-right-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 1rem;
      }

      .events-table td.map-cell {
        display: block;
        padding: 0.75rem;
        border-bottom: none;
      }

      .events-table td.map-cell::before {
        display: none;
      }

      .map-container {
        position: static;
        width: 100%;
        max-width: 100%;
        min-height: 120px;
      }
    }
  </style>
  <script>
    const toggleMap = (srcElement, eventId, event) => {
      if (event) {
        event.preventDefault();
      }
      const mapRow = document.getElementById(`map-row-${eventId}`);
      if (!mapRow) return;

      const isHidden = mapRow.classList.contains('hidden');
      const eventRow = document.getElementById(`row-${eventId}`);

      if (isHidden) {
        mapRow.classList.remove('hidden');
        if (eventRow) eventRow.classList.add('is-expanded');
        srcElement.textContent = "Hide Map";
        srcElement.setAttribute('aria-expanded', 'true');

        const img = mapRow.querySelector('img');
        const loader = document.getElementById(`loader-${eventId}`);

        if (img && img.complete && img.naturalWidth > 0) {
          if (loader) loader.classList.add('hidden');
          img.classList.remove('is-loading');
        } else {
          if (loader) loader.classList.remove('hidden');
          if (img) img.classList.add('is-loading');
        }
      } else {
        mapRow.classList.add('hidden');
        if (eventRow) eventRow.classList.remove('is-expanded');
        srcElement.textContent = "Show Map";
        srcElement.setAttribute('aria-expanded', 'false');
      }
    };

    const handleMapLoad = (img, eventId) => {
      const loader = document.getElementById(`loader-${eventId}`);
      if (loader) loader.classList.add('hidden');
      img.classList.remove('is-loading');
    };

    const handleMapError = (img, eventId) => {
      const loader = document.getElementById(`loader-${eventId}`);
      if (loader) {
        const text = loader.querySelector('.loader-text');
        if (text) text.textContent = "Failed to load map.";
        const spinner = loader.querySelector('.map-spinner');
        if (spinner) spinner.classList.add('hidden');
      }
    };
  </script>
</head>
<body>
  <div class="container">
    <header class="page-header">
      <h1>Seattle City Light Outages</h1>
      <p class="subtitle">This is an unofficial, very low bandwidth version of
        <a href="https://www.seattle.gov/city-light/outages">this page</a>.
      </p>

      <p>
        There are currently {{ total_outage_count }} outages affecting {{ total_people_affected }} people.
        Data is refreshed every {{ events_file_expiration }} mins, last checked at
        {{ pretty_datetime(events_date, False) }}.
      </p>
    </header>

    {% if events|length > 0 %}
    <main class="events-list">
      <div class="table-container">
        <table class="events-table" aria-label="Seattle City Light Outage Events">
          <thead>
            <tr>
              <th scope="col" class="col-neighborhood">Neighborhood</th>
              <th scope="col" class="col-title">Title</th>
              <th scope="col" class="col-affected">Affected</th>
              <th scope="col" class="col-status">Status</th>
              <th scope="col" class="col-cause">Cause</th>
              <th scope="col" class="col-start">Start</th>
              <th scope="col" class="col-etr">Est Restoration</th>
              <th scope="col" class="col-updated">Updated</th>
              <th scope="col" class="col-map">Map</th>
            </tr>
          </thead>
          <tbody>
            {% for e in events %}
            <tr class="event-row" id="row-{{ e.identifier }}">
              <td class="col-neighborhood" data-label="Neighborhood">{{ e.neighborhood }}</td>
              <td class="col-title" data-label="Title">{{ e.title }}</td>
              <td class="col-affected" data-label="Affected">
                <span class="badge-impact">{{ e.numPeople }}</span>
              </td>
              <td class="col-status" data-label="Status">
                <span class="status-tag">{{ e.status }}</span>
              </td>
              <td class="col-cause" data-label="Cause">{{ e.cause }}</td>
              <td class="col-start" data-label="Start">{{ pretty_datetime(e.startTime) }}</td>
              <td class="col-etr" data-label="Est Restoration">{{ pretty_datetime(e.etrTime) }}</td>
              <td class="col-updated" data-label="Updated">{{ pretty_datetime(e.lastUpdatedTime) }}</td>
              <td class="col-map" data-label="Map">
                <a
                  href="events_map/{{ e.identifier }}?ts={{ ts }}"
                  class="map-link"
                  id="map-link-{{ e.identifier }}"
                  role="button"
                  aria-expanded="false"
                  aria-controls="map-row-{{ e.identifier }}"
                  onclick="toggleMap(this, '{{ e.identifier }}', event); return false;"
                >Show Map</a>
              </td>
            </tr>
            <tr class="map-row hidden" id="map-row-{{ e.identifier }}">
              <td colspan="9" class="map-cell">
                <div class="map-container map-container-{{ e.identifier }}">
                  <div class="map-loader" id="loader-{{ e.identifier }}">
                    <span class="map-spinner" aria-hidden="true"></span>
                    <span class="loader-text">Loading map...</span>
                  </div>
                  <img
                    src="events_map/{{ e.identifier }}?ts={{ ts }}"
                    class="is-loading"
                    loading="lazy"
                    alt="Map of affected area for event {{ e.identifier }}"
                    onload="handleMapLoad(this, '{{ e.identifier }}')"
                    onerror="handleMapError(this, '{{ e.identifier }}')"
                  >
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </main>
    {% else %}
    <main>
      <article class="no-events">
        <span class="emoji">&#x1F389;&#x1F389;&#x1F389;</span>
      </article>
    </main>
    {% endif %}

    <footer class="page-footer">
      <a href="https://github.com/codeforkjeff/scl-outage" class="github-link" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" height="16" width="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </footer>
  </div>
</body>
</html>
